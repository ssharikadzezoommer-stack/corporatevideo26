const STATUS_META = {
  'Welcome კადრი':   { cls: 's-welcome', icon: '🎉', color: '#93c5fd' },
  'დარბაზის კადრი':  { cls: 's-darbazi', icon: '🏛️', color: '#86efac' },
  'გარე კადრი':      { cls: 's-gare',    icon: '🌿', color: '#fcd34d' },
  'კარის კადრი':     { cls: 's-karis',   icon: '🚪', color: '#c4b5fd' },
  'ai კადრი':        { cls: 's-ai',      icon: '🤖', color: '#818cf8' },
  'კონცერტი':        { cls: 's-koncert', icon: '🎵', color: '#fca5a5' },
  'დრონის კადრი':    { cls: 's-droni',   icon: '🚁', color: '#6ee7b7' },
  'DJ':              { cls: 's-dj',      icon: '🎧', color: '#f0abfc' },
};

let activeStatus = 'all';
let activeCam = 'all';
let sortKey = 'start';
let sortDir = 1;
let searchQ = '';

function getDuration(r) {
  const ts = s => { const p = s.split(':'); return (+p[0])*3600 + (+p[1])*60 + (+p[2]); };
  if (!r.start || !r.end) return 0;
  return Math.max(0, ts(r.end) - ts(r.start));
}

function fmtDur(sec) {
  if (!sec) return '—';
  return sec + 's';
}

function statusClass(s) {
  return STATUS_META[s]?.cls || 's-darbazi';
}

function statusIcon(s) {
  return STATUS_META[s]?.icon || '📹';
}

// Build status filter buttons
(function buildFilters() {
  const counts = {};
  DATA.forEach(d => { counts[d.status] = (counts[d.status]||0)+1; });
  const bar = document.getElementById('status-filters');
  Object.keys(counts).sort().forEach(s => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.setAttribute('data-s', s);
    btn.innerHTML = `${statusIcon(s)} ${s} <b style="opacity:0.6;font-size:11px">${counts[s]}</b>`;
    btn.onclick = () => setStatus(s);
    bar.appendChild(btn);
  });

  // Stats bar
  const statsBar = document.getElementById('stats-bar');
  Object.keys(STATUS_META).forEach(s => {
    if (!counts[s]) return;
    const m = STATUS_META[s];
    statsBar.innerHTML += `<div class="stat-chip"><div class="stat-dot" style="background:${m.color}"></div><span class="stat-label">${s}</span><span class="stat-count">${counts[s]}</span></div>`;
  });
})();

function setStatus(s) {
  activeStatus = s;
  document.querySelectorAll('.filter-btn').forEach(b => {
    b.classList.toggle('active', b.getAttribute('data-s') === s);
    if (b.classList.contains('active')) {
      const m = s !== 'all' ? STATUS_META[s] : null;
      b.style.background = m ? m.color + '33' : '#6366f1';
      b.style.borderColor = m ? m.color : '#6366f1';
      b.style.color = m ? m.color : '#fff';
    } else {
      b.style.background = '';
      b.style.borderColor = '';
      b.style.color = '';
    }
  });
  render();
}

function setCam(c) {
  activeCam = c;
  document.querySelectorAll('.cam-btn').forEach(b => {
    const t = b.textContent.trim();
    b.classList.toggle('active',
      (c==='all' && t==='ყველა') ||
      (c==='CAMERA 1 TIMECODE' && t==='CAM 1') ||
      (c==='CAMERA 2 TIMECODE' && t==='CAM 2')
    );
  });
  render();
}

function sortBy(key) {
  if (sortKey === key) { sortDir *= -1; }
  else { sortKey = key; sortDir = 1; }
  document.querySelectorAll('th').forEach(th => {
    th.classList.remove('sorted');
    const icon = th.querySelector('.sort-icon');
    if (icon) icon.textContent = '↕';
  });
  const headers = { start: 1, end: 2, camera: 5 };
  const idx = headers[key];
  const ths = document.querySelectorAll('thead th');
  if (ths[idx]) {
    ths[idx].classList.add('sorted');
    ths[idx].querySelector('.sort-icon').textContent = sortDir === 1 ? '↑' : '↓';
  }
  render();
}

document.getElementById('search').addEventListener('input', e => {
  searchQ = e.target.value.toLowerCase();
  render();
});

function render() {
  let rows = DATA.filter(r => {
    if (activeStatus !== 'all' && r.status !== activeStatus) return false;
    if (activeCam !== 'all' && r.camera !== activeCam) return false;
    if (searchQ) {
      const haystack = [r.start, r.end, r.status, r.camera].join(' ').toLowerCase();
      if (!haystack.includes(searchQ)) return false;
    }
    return true;
  });

  rows.sort((a, b) => {
    const va = a[sortKey] || '';
    const vb = b[sortKey] || '';
    return sortDir * va.localeCompare(vb);
  });

  const tbody = document.getElementById('tbody');
  if (rows.length === 0) {
    tbody.innerHTML = `<tr><td colspan="8"><div class="empty-state"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><div>ჩანაწერი არ მოიძებნა</div></div></td></tr>`;
  } else {
    tbody.innerHTML = rows.map((r, i) => {
      const sc = statusClass(r.status);
      const si = statusIcon(r.status);
      const dur = getDuration(r);
      const cam = r.camera === 'CAMERA 1 TIMECODE' ? 'cam1' : 'cam2';
      const camLabel = r.camera === 'CAMERA 1 TIMECODE' ? 'CAM 1' : 'CAM 2';
      return `<tr>
        <td class="row-num">${i+1}</td>
        <td class="timecode-cell"><span class="time-start">${r.start}</span></td>
        <td class="timecode-cell"><span class="time-end">${r.end}</span></td>
        <td><span class="duration-pill">${fmtDur(dur)}</span></td>
        <td><span class="status-badge ${sc}">${si} ${r.status}</span></td>
        <td><span class="camera-label ${cam}">${camLabel}</span></td>
        <td>${r.url_start ? `<a href="${r.url_start}" target="_blank" class="link-btn link-start">▶ START</a>` : '—'}</td>
        <td>${r.url_end ? `<a href="${r.url_end}" target="_blank" class="link-btn link-end">⏹ END</a>` : '—'}</td>
      </tr>`;
    }).join('');
  }

  document.getElementById('result-count').textContent = `ნაჩვენებია: ${rows.length} / ${DATA.length}`;
}

render();
</script>
</body>
</html>
