    border-bottom: 1px solid #2d3748;
    padding: 24px 32px;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
  }

  .logo {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.5px;
  }

  .logo span { color: #6366f1; }

  .total-badge {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    color: #94a3b8;
  }

  .total-badge b { color: #e2e8f0; }

  .controls {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .search-wrap {
    position: relative;
    flex: 1;
    min-width: 200px;
    max-width: 340px;
  }

  .search-wrap svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #64748b;
    pointer-events: none;
  }

  input[type="text"] {
    width: 100%;
    padding: 9px 12px 9px 38px;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    color: #e2e8f0;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
  }

  input[type="text"]:focus { border-color: #6366f1; }

  .filter-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 7px 14px;
    border-radius: 20px;
    border: 1.5px solid #334155;
    background: transparent;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.18s;
    font-family: inherit;
    white-space: nowrap;
  }

  .filter-btn:hover { border-color: #6366f1; color: #c7d2fe; }

  .filter-btn.active {
    border-color: transparent;
    color: #fff;
    font-weight: 600;
  }

  /* Camera toggle */
  .cam-toggle {
    display: flex;
    background: #1e293b;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #334155;
  }

  .cam-btn {
    padding: 8px 16px;
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s;
    font-family: inherit;
  }

  .cam-btn.active { background: #6366f1; color: #fff; }

  /* Main content */
  .container { padding: 24px 32px; max-width: 1400px; margin: 0 auto; }

  /* Stats bar */
  .stats-bar {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .stat-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #1e293b;
    border-radius: 8px;
    border: 1px solid #2d3748;
    font-size: 13px;
  }

  .stat-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
  }

  .stat-label { color: #64748b; }
  .stat-count { font-weight: 700; color: #e2e8f0; }

  /* Table */
  .table-wrap {
    background: #141924;
    border: 1px solid #1e293b;
    border-radius: 12px;
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  thead tr {
    background: #1a2234;
    border-bottom: 2px solid #2d3748;
  }

  th {
    padding: 14px 16px;
    text-align: left;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #64748b;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }

  th:hover { color: #94a3b8; }

  th.sorted { color: #818cf8; }

  th .sort-icon { margin-left: 4px; opacity: 0.5; }
  th.sorted .sort-icon { opacity: 1; }

  tbody tr {
    border-bottom: 1px solid #1e293b;
    transition: background 0.12s;
  }

  tbody tr:last-child { border-bottom: none; }

  tbody tr:hover { background: #1a2234; }

  tbody tr.hidden { display: none; }

  td { padding: 12px 16px; vertical-align: middle; }

  .row-num {
    color: #374151;
    font-size: 12px;
    font-weight: 600;
    min-width: 32px;
  }

  .timecode-cell {
    font-family: 'Courier New', monospace;
    font-size: 13px;
    font-weight: 600;
  }

  .time-start { color: #34d399; }
  .time-end { color: #f87171; }
  .time-arrow { color: #374151; margin: 0 4px; }

  .duration-pill {
    display: inline-block;
    padding: 2px 8px;
    background: #1e293b;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    font-family: monospace;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .camera-label {
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .cam1 { background: #1e3a5f; color: #60a5fa; }
  .cam2 { background: #3b1f5f; color: #a78bfa; }

  .link-cell { display: flex; gap: 8px; }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .link-start {
    background: #14532d;
    color: #4ade80;
    border: 1px solid #166534;
  }

  .link-start:hover { background: #166534; color: #86efac; }

  .link-end {
    background: #4c0519;
    color: #fb7185;
    border: 1px solid #9f1239;
  }

  .link-end:hover { background: #9f1239; color: #fda4af; }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #475569;
  }

  .empty-state svg { margin-bottom: 16px; opacity: 0.4; }

  /* Result count */
  .result-info {
    padding: 10px 16px;
    background: #0f1117;
    border-top: 1px solid #1e293b;
    font-size: 12px;
    color: #475569;
    display: flex;
    justify-content: space-between;
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: #0f1117; }
  ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: #475569; }

  /* Responsive */
  @media (max-width: 768px) {
    header, .container { padding: 16px; }
    .header-top { margin-bottom: 12px; }
    th, td { padding: 10px 10px; }
    .link-cell { flex-direction: column; }
  }

