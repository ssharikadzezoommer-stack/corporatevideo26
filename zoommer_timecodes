  .s-welcome   { background: #1e3a5f44; color: #93c5fd; border: 1px solid #1e3a5f; }
  .s-darbazi   { background: #14532d44; color: #86efac; border: 1px solid #14532d; }
  .s-gare      { background: #78350f44; color: #fcd34d; border: 1px solid #78350f; }
  .s-karis     { background: #4c1d9544; color: #c4b5fd; border: 1px solid #4c1d95; }
  .s-ai        { background: #0e1a4444; color: #818cf8; border: 1px solid #1e40af; }
  .s-koncert   { background: #7f1d1d44; color: #fca5a5; border: 1px solid #7f1d1d; }
  .s-droni     { background: #052e1644; color: #6ee7b7; border: 1px solid #065f46; }
  .s-dj        { background: #13121844; color: #f0abfc; border: 1px solid #701a75; }
</style>
